#!/bin/sh /etc/rc.common

# This tells OpenWrt to manage this service via the procd process supervisor
USE_PROCD=1

# Execution order priority in the boot sequence (starts late, stops early)
START=95
STOP=10

start_service() {
    # Open a named process instance boundary within procd management
    procd_open_instance "sysdiagnostic_instance"

    # Command to run: native Python 3 interpreter pointing to our main script file
    procd_set_param command /usr/sbin/sysdiagnostic

    # The Watchdog/Respawn feature: automatic crash recovery
    # Parameters: <threshold_seconds> <timeout_seconds> <max_retry_attempts>
    # If the process crashes in less than 3600 seconds, procd waits 5 seconds and revives it (up to 5 retries).
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}

    # Intercept process stdout/stderr descriptors and pipe them straight into system logread
    procd_set_param stdout 1
    procd_set_param stderr 1

    # Required for execute the trigger when execute reload_config command
    procd_set_param file /etc/config/sysdiagnostic

    # Finalize and push the instance configuration down to the supervisor engine
    procd_close_instance
}

service_triggers() {
    # Automatic Reload Trigger management:
    # If an operator runs 'uci commit sysdiagnostic', procd intercepts the change 
    # and automatically transmits a SIGTERM signal to flush and reload our Python daemon process.
    procd_add_reload_trigger "sysdiagnostic"
}

